COMPOSE_PROJECT_NAME=manhole-settlement
FRONTEND_PORT=18269
BACKEND_PORT=19269
DB_PORT=17769
POSTGRES_DB=municipal_ops
POSTGRES_USER=municipal_ops
POSTGRES_PASSWORD=municipal_ops_local
DATABASE_URL=postgresql+psycopg://municipal_ops:municipal_ops_local@db:5432/municipal_ops
REDIS_URL=redis://redis:6379/0
JWT_SECRET=manhole-settlement-local-secret
SEED_DEMO=true
# 任务租约秒数：超过该时长未续租的 running 任务会被收回队列重新接手
JOB_LEASE_SECONDS=20
# 故障注入（留空关闭）。填 analysis_jobs 的主键 id：
# CRASH_AFTER_CLAIM_JOB_ID=1   worker 认领该任务后立即退出，等待租约接管
# HANG_AFTER_CLAIM_JOB_ID=1    worker 认领后持租约挂起，复现旧进程迟到写入被 fencing 拦截
CRASH_AFTER_CLAIM_JOB_ID=
HANG_AFTER_CLAIM_JOB_ID=
